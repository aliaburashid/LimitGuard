{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimitGuard audit event v1",
  "description": "References one authoritative audit_logs row. Publish to limitguard.audit.events.v1 using financialInstitutionId:entityType:entityId as the Kafka key.",
  "type": "object",
  "required": [
    "eventId",
    "schemaVersion",
    "sourceService",
    "auditLogId",
    "financialInstitutionId",
    "action",
    "entityType",
    "entityId",
    "actorId",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Stable outbox event ID, reused on every retry."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceService": {
      "enum": ["auth-service", "credit-service"]
    },
    "auditLogId": { "$ref": "#/$defs/databaseId" },
    "financialInstitutionId": { "$ref": "#/$defs/databaseId" },
    "action": { "$ref": "#/$defs/auditLabel" },
    "entityType": { "$ref": "#/$defs/auditLabel" },
    "entityId": { "$ref": "#/$defs/databaseId" },
    "actorId": {
      "description": "The recorded actor ID, or null for a system-generated action.",
      "anyOf": [
        { "$ref": "#/$defs/databaseId" },
        { "type": "null" }
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "The recorded audit time converted to UTC using the verified writer time zone."
    }
  },
  "$defs": {
    "databaseId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "auditLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    }
  }
}
